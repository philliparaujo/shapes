# Build output
[Bb]in/
[Oo]bj/
# Source-generator output, emitted only when diagnosing with EmitCompilerGeneratedFiles
generated/
[Dd]ebug/
[Rr]elease/
artifacts/

# Test results
[Tt]est[Rr]esult*/
*.trx
coverage*.json
coverage*.xml
*.coverage

# IDE
.vs/
.vscode/
.idea/
*.user
*.suo
*.userprefs

# Balance run outputs (experiment logs are committed; raw data is not)
balance/**/*.csv
balance/**/raw/
# Sim run artifacts (--metrics-json / --report / --compare-report output).
# DESIGN.md's runbook writes these into out/; the whole directory is generated.
out/

# Godot (Phase 4)
.godot/
*.translation

# Exported builds (DESIGN.md D6)
Shapes.Godot/Exports/

# Mirrored into the resource tree at build time from Shapes.Content (Shapes.Godot.csproj's
# MirrorContentIntoResourceTree target) -- regenerated on every build, never edited in place.
Shapes.Godot/Content/

# OS
Thumbs.db
.DS_Store

# Secrets -- SSH keys for the relay VM live here, never committed.
# See DESIGN.md "SSH into the relay VM" for the deploy commands that read them.
.secrets/
server/
*.key
