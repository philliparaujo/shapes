<Project Sdk="Godot.NET.Sdk/4.5.1">
  <ItemGroup>
    <ProjectReference Include="..\Shapes.Core\Shapes.Core.csproj" />
    <ProjectReference Include="..\Shapes.Ai\Shapes.Ai.csproj" />
    <ProjectReference Include="..\Shapes.Content\Shapes.Content.csproj" />
    <ProjectReference Include="..\Shapes.Godot.Adapter\Shapes.Godot.Adapter.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <!--
    Card/ruleset JSON must reach res:// to be readable on Android: .NET's own publish-output copy
    (Shapes.Content.csproj's CopyToOutputDirectory) lands next to the DLLs, which is a real folder
    on desktop but only a zip entry inside the APK on Android, so AppContext.BaseDirectory-based
    loading throws there (Lobby.cs's card load used to run before any Home button got wired, so
    the throw looked exactly like "touch doesn't work"; see DESIGN.md D6). Mirroring it into this
    project's own Content folder puts it through Godot's normal resource import, the same path
    Art and Audio already use, so it packs into the .pck/APK identically to every other asset.
    export_presets.cfg's include_filter must also name Content/*.json explicitly: Godot does not
    treat .json as an importable resource, so "export all resources" alone still ships an empty
    Content entry.
  -->
  <Target Name="MirrorContentIntoResourceTree" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <ContentJsonCards Include="..\Shapes.Content\cards\**\*.json" />
      <ContentJsonCalibration Include="..\Shapes.Content\cards-calibration\**\*.json" />
      <ContentJsonRulesets Include="..\Shapes.Content\rulesets\**\*.json" />
    </ItemGroup>
    <Copy
      SourceFiles="@(ContentJsonCards)"
      DestinationFiles="@(ContentJsonCards -> 'Content\cards\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
    <Copy
      SourceFiles="@(ContentJsonCalibration)"
      DestinationFiles="@(ContentJsonCalibration -> 'Content\cards-calibration\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
    <Copy
      SourceFiles="@(ContentJsonRulesets)"
      DestinationFiles="@(ContentJsonRulesets -> 'Content\rulesets\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>
</Project>