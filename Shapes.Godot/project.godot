; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Shapes"
run/main_scene="res://Scenes/Lobby.tscn"
config/features=PackedStringArray("4.5", "C#", "Mobile")
config/icon="res://icon.svg"

[autoload]

; PLAN.md D4. An autoload because music must survive ChangeSceneToFile -- the lobby, deckbuilder,
; card browser and a match are four separate scenes, and a player owned by any one of them would
; stop (and restart from the top) at every transition. See AudioDirector's own header.
AudioDirector="*res://Scripts/AudioDirector.cs"

[display]

window/size/viewport_width=1600
window/size/viewport_height=1000
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="Shapes.Godot"

[rendering]

renderer/rendering_method="mobile"
