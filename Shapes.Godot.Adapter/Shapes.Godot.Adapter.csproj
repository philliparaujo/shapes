<Project Sdk="Microsoft.NET.Sdk">

  <!--
    UI adapter layer for the Godot client (DESIGN.md Phase 5 step A2): GameSession/StateDiff,
    the only code allowed to touch GameState. A plain class library rather than living inside
    Shapes.Godot itself, so it builds and tests under a normal dotnet build/dotnet test call.
    The Godot.NET.Sdk's source generator requires a GodotProjectDir MSBuild property that only
    the Godot editor/CLI supplies, which breaks referencing Shapes.Godot.csproj from
    Shapes.Tests. Shapes.Godot consumes this project; it stays UI-free the same way
    Shapes.Core does.
  -->

  <ItemGroup>
    <ProjectReference Include="..\Shapes.Core\Shapes.Core.csproj" />
    <ProjectReference Include="..\Shapes.Ai\Shapes.Ai.csproj" />
  </ItemGroup>

</Project>
