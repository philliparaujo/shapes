<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Data-only project: card definitions and rulesets as JSON. No C# compiles here.
    Consumers reference this to get the content copied into their output directory,
    which keeps card data editable without a rebuild of the engine.
  -->

  <PropertyGroup>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    Cards and rulesets stay in separate output folders rather than being flattened into one.
    CardLoader.FromDirectory reads every *.json under the directory it is given, so a shared
    folder would have it try to parse default.json as a card and fail the whole content set.
  -->
  <ItemGroup>
    <Content Include="cards\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Content\cards\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </Content>
    <Content Include="rulesets\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Content\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </Content>
    <!--
      Calibration spells (DESIGN.md step 4.2e): deliberately mispriced cards used to validate
      the metrics detectors against a known-wrong answer. Kept in a separate output folder, not
      merged into cards\, so CardDatabase.BuildSymmetricDeck never picks them up for a real run
      and CardSetHash (which only hashes cards\) never sees them.
    -->
    <Content Include="cards-calibration\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Content\cards-calibration\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </Content>
  </ItemGroup>

</Project>
