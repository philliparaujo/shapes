<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Data-only project: card definitions and rulesets as JSON. No C# compiles here.
    Consumers reference this to get the content copied into their output directory,
    which keeps card data editable without a rebuild of the engine.
  -->

  <PropertyGroup>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="cards\**\*.json;rulesets\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>Content\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </Content>
  </ItemGroup>

</Project>
