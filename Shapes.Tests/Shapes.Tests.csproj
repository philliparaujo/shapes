<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared build settings live in ../Directory.Build.props. -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shapes.Core\Shapes.Core.csproj" />
    <ProjectReference Include="..\Shapes.Ai\Shapes.Ai.csproj" />
    <!-- Card-data validation (step 1.7) loads the real content set. -->
    <ProjectReference Include="..\Shapes.Content\Shapes.Content.csproj" />
    <!--
      Step 2.5's hidden-hand rendering. Console rendering is generally not worth testing (see
      DESIGN.md's coverage target), but WHICH HAND IS HIDDEN is not rendering. It is the property
      that makes a human-v-AI result mean something, so it gets pinned like any other.
    -->
    <ProjectReference Include="..\Shapes.Console\Shapes.Console.csproj" />
    <!-- Step 3.1's batch runner: option parsing, seed derivation, and result aggregation. -->
    <ProjectReference Include="..\Shapes.Sim\Shapes.Sim.csproj" />
    <!-- Step 5 A2's UI adapter: GameSession/StateDiff, the only layer allowed to touch GameState. -->
    <ProjectReference Include="..\Shapes.Godot.Adapter\Shapes.Godot.Adapter.csproj" />
  </ItemGroup>

</Project>
